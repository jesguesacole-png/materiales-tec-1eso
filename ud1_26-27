<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>U1 · El Proceso Tecnológico, el Taller y los Proyectos</title>
<meta name="description" content="Tecnología y Digitalización 1.º ESO · Unidad 1 · Estudio bilingüe (ES/EN): contenidos, flashcards, práctica, examen y apuntes imprimibles.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#16365c; --blue:#1f6fb2; --blue-soft:#e3eef9;
  --orange:#e8710a; --orange-soft:#fdeedd;
  --green:#2e8540; --green-soft:#e2f2e5;
  --red:#c0392b; --red-soft:#fbe5e2;
  --yellow:#f2b705; --yellow-soft:#fdf5d6;
  --purple:#7b3fa0; --purple-soft:#f1e7f7;
  --ink:#1d2733; --muted:#5b6876; --line:#c9d6e3;
  --paper:#fbfcfe; --card:#ffffff; --grid:rgba(31,111,178,.07);
  --radius:12px;
  --font-body:"Atkinson Hyperlegible", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  --font-head:"Barlow Condensed", "Arial Narrow", system-ui, sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; font-family:var(--font-body); color:var(--ink); font-size:17px; line-height:1.55;
  background-color:var(--paper);
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:24px 24px;
}
h1,h2,h3,h4{font-family:var(--font-head); color:var(--navy); line-height:1.15; margin:0 0 .5em; letter-spacing:.01em}
h1{font-size:2.2rem} h2{font-size:1.75rem} h3{font-size:1.3rem} h4{font-size:1.1rem}
p{margin:0 0 .8em}
button{font:inherit; cursor:pointer}
button:focus-visible, summary:focus-visible, select:focus-visible, input:focus-visible{outline:3px solid var(--orange); outline-offset:2px}
.wrap{max-width:1040px; margin:0 auto; padding:0 16px}

/* ---------- header / nav ---------- */
header.top{background:var(--navy); color:#fff; position:sticky; top:0; z-index:20; box-shadow:0 2px 8px rgba(0,0,0,.18)}
.top-row{display:flex; align-items:center; gap:12px; padding:10px 0; flex-wrap:wrap}
.brand{display:flex; flex-direction:column; flex:1; min-width:200px}
.brand small{opacity:.8; font-size:.8rem; letter-spacing:.04em; text-transform:uppercase}
.brand b{font-family:var(--font-head); font-size:1.25rem; letter-spacing:.02em}
.lang{display:flex; border:2px solid rgba(255,255,255,.6); border-radius:999px; overflow:hidden}
.lang button{background:transparent; color:#fff; border:0; padding:6px 14px; font-weight:700; font-size:.95rem}
.lang button[aria-pressed="true"]{background:var(--orange); color:#fff}
nav.tabs{display:flex; gap:4px; overflow-x:auto; padding-bottom:8px; scrollbar-width:thin}
nav.tabs a{color:#dbe7f5; text-decoration:none; padding:7px 12px; border-radius:8px; white-space:nowrap; font-weight:700; font-size:.95rem}
nav.tabs a:hover{background:rgba(255,255,255,.12); color:#fff}
nav.tabs a[aria-current="page"]{background:#fff; color:var(--navy)}

main{padding:24px 0 60px}
.view{display:none}
.view.active{display:block}

/* ---------- generic ---------- */
.card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; box-shadow:0 1px 3px rgba(22,54,92,.06)}
.btn{display:inline-flex; align-items:center; gap:6px; border:2px solid var(--navy); background:var(--navy); color:#fff; padding:9px 16px; border-radius:10px; font-weight:700; font-size:.98rem; text-decoration:none}
.btn:hover{filter:brightness(1.12)}
.btn.ghost{background:#fff; color:var(--navy)}
.btn.orange{background:var(--orange); border-color:var(--orange)}
.btn.green{background:var(--green); border-color:var(--green)}
.btn.red{background:var(--red); border-color:var(--red)}
.btn:disabled{opacity:.45; cursor:not-allowed; filter:none}
.row{display:flex; gap:10px; flex-wrap:wrap; align-items:center}
.muted{color:var(--muted)}
label.field{display:flex; flex-direction:column; gap:4px; font-weight:700; font-size:.92rem; color:var(--navy)}
select,input[type=text]{font:inherit; padding:8px 10px; border:2px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); min-width:180px}
.tag{display:inline-block; font-family:var(--font-head); font-weight:700; letter-spacing:.05em; text-transform:uppercase; font-size:.85rem; padding:2px 10px; border-radius:6px; background:var(--blue-soft); color:var(--blue)}
.tag.orange{background:var(--orange-soft); color:#a34d00}
.tag.green{background:var(--green-soft); color:var(--green)}
.progress{height:10px; background:var(--blue-soft); border-radius:999px; overflow:hidden}
.progress > span{display:block; height:100%; background:var(--orange); width:0; transition:width .25s}

/* ---------- home ---------- */
.hero{display:grid; gap:18px; grid-template-columns:1.3fr 1fr; align-items:center; margin-bottom:24px}
.hero h1{font-size:2.6rem}
.hero .formula-mini{font-family:var(--font-head); font-size:1.6rem; color:var(--navy)}
.modes{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px}
.mode{display:flex; flex-direction:column; gap:6px; text-decoration:none; color:inherit; border-top:6px solid var(--blue)}
.mode:hover{transform:translateY(-2px); box-shadow:0 6px 16px rgba(22,54,92,.12)}
.mode .ico{font-size:1.8rem}
.mode h3{margin:0}
.mode.c2{border-top-color:var(--orange)} .mode.c3{border-top-color:var(--green)} .mode.c4{border-top-color:var(--red)} .mode.c5{border-top-color:var(--purple)}

/* ---------- contents (accordion) ---------- */
.acc-tools{display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px}
details.sec{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); margin-bottom:10px; overflow:hidden}
details.sec > summary{list-style:none; cursor:pointer; padding:14px 18px; display:flex; align-items:center; gap:12px; font-family:var(--font-head); font-size:1.35rem; font-weight:700; color:var(--navy)}
details.sec > summary::-webkit-details-marker{display:none}
details.sec > summary .num{flex:none; width:34px; height:34px; border-radius:8px; background:var(--navy); color:#fff; display:grid; place-items:center; font-size:1.1rem}
details.sec > summary::after{content:"+"; margin-left:auto; font-size:1.6rem; color:var(--orange); font-family:var(--font-body)}
details.sec[open] > summary::after{content:"–"}
details.sec[open] > summary{border-bottom:1px solid var(--line); background:var(--blue-soft)}
.sec-body{padding:16px 20px 20px}

/* ---------- content blocks (shared by screen + print) ---------- */
.doc h3{margin-top:1.1em; color:var(--blue)}
.doc ul,.doc ol{margin:0 0 .9em; padding-left:1.3em}
.doc li{margin-bottom:.25em}
.doc table{width:100%; border-collapse:collapse; margin:0 0 1em; font-size:.95rem; background:#fff}
.doc th,.doc td{border:1px solid var(--line); padding:8px 10px; text-align:left; vertical-align:top}
.doc th{background:var(--navy); color:#fff; font-weight:700}
.doc tr:nth-child(even) td{background:#f5f8fc}
.tbl-scroll{overflow-x:auto}
.key{border-left:6px solid var(--orange); background:var(--orange-soft); padding:10px 14px; border-radius:8px; margin:0 0 1em}
.key b:first-child{color:#a34d00}
.note{border-left:6px solid var(--blue); background:var(--blue-soft); padding:10px 14px; border-radius:8px; margin:0 0 1em}
.activity{border:2px dashed var(--orange); border-radius:10px; padding:12px 16px; margin:0 0 1em; background:#fffaf4}
.activity > .tag{margin-bottom:6px}
.activity h4{margin:.2em 0 .4em}
details.sol{margin-top:8px}
details.sol > summary{cursor:pointer; font-weight:700; color:var(--green)}
.sol-print{display:none; margin-top:8px; border-top:1px solid var(--line); padding-top:6px}
.sol-print b.sl{color:var(--green)}
.formula{display:flex; flex-wrap:wrap; align-items:stretch; gap:8px; margin:0 0 1em}
.formula .fx{flex:1 1 130px; border-radius:10px; padding:10px; text-align:center; border:2px solid}
.formula .fx b{display:block; font-family:var(--font-head); font-size:1.45rem}
.formula .op{align-self:center; font-family:var(--font-head); font-size:2rem; font-weight:700; color:var(--navy)}
.fx.c{border-color:var(--blue); background:var(--blue-soft)} .fx.c b{color:var(--blue)}
.fx.t{border-color:var(--green); background:var(--green-soft)} .fx.t b{color:var(--green)}
.fx.h{border-color:var(--orange); background:var(--orange-soft)} .fx.h b{color:#b85600}
.fx.r{border-color:var(--purple); background:var(--purple-soft)} .fx.r b{color:var(--purple)}
.twocol{display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:1em}
.box{border:2px solid var(--line); border-radius:10px; padding:10px 14px; background:#fff}
.box h4{margin-top:0}
.box.blue{border-color:var(--blue)} .box.blue h4{color:var(--blue)}
.box.orange{border-color:var(--orange)} .box.orange h4{color:#b85600}
.box.green{border-color:var(--green)} .box.green h4{color:var(--green)}
.box.red{border-color:var(--red)} .box.red h4{color:var(--red)}
.box.yellow{border-color:var(--yellow)} .box.yellow h4{color:#8a6900}
.box.purple{border-color:var(--purple)} .box.purple h4{color:var(--purple)}
.grid3{display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:1em}
.grid2{display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-bottom:1em}
.mantra{font-family:var(--font-head); font-size:1.3rem; font-weight:700; text-align:center; background:var(--yellow-soft); border:3px solid var(--yellow); border-radius:10px; padding:10px; margin:0 0 1em; color:var(--ink)}
.steps{counter-reset:st; list-style:none; padding:0!important}
.steps li{counter-increment:st; position:relative; padding:6px 0 6px 44px; margin:0!important; border-bottom:1px dashed var(--line)}
.steps li::before{content:counter(st); position:absolute; left:0; top:6px; width:30px; height:30px; border-radius:50%; background:var(--navy); color:#fff; display:grid; place-items:center; font-weight:700; font-size:.95rem}
.fig{margin:0 0 1em; text-align:center}
.fig svg{max-width:100%; height:auto}
.fig figcaption{font-size:.88rem; color:var(--muted)}
.quote{font-family:var(--font-head); font-size:1.4rem; text-align:center; color:var(--navy); border:3px solid var(--navy); border-radius:12px; padding:12px 16px; margin:1em 0}

/* circuit widget */
.circuit{list-style:none; padding:0!important; margin:8px 0}
.circuit li{display:flex; align-items:center; gap:8px; background:#f3e3c8; border:1px solid #d9bf95; border-radius:8px; padding:7px 8px; margin-bottom:6px!important}
.circuit li .pos{flex:none; width:28px; height:28px; border-radius:6px; background:#fff; border:2px solid #b38b4d; display:grid; place-items:center; font-weight:700}
.circuit li .txt{flex:1}
.circuit li button{border:1px solid #b38b4d; background:#fff; border-radius:6px; width:34px; height:30px; font-weight:700}
.circuit li.ok{background:var(--green-soft); border-color:var(--green)}
.circuit li.bad{background:var(--red-soft); border-color:var(--red)}
.circuit-static{list-style:none; padding:0!important}
.circuit-static li{display:flex; gap:10px; align-items:center; margin-bottom:6px!important}
.circuit-static .blank{flex:none; width:30px; height:26px; border:2px solid var(--ink); border-radius:4px}

/* ---------- flashcards ---------- */
.fc-stage{perspective:1400px; margin:14px auto; max-width:720px}
.fc{display:grid; cursor:pointer; transition:transform .5s; transform-style:preserve-3d; min-height:280px}
.fc.flipped{transform:rotateY(180deg)}
.fc-face{grid-area:1/1; backface-visibility:hidden; -webkit-backface-visibility:hidden; border-radius:16px; padding:28px 26px; display:flex; flex-direction:column; justify-content:center; gap:10px; border:2px solid var(--navy); background:#fff; box-shadow:0 6px 18px rgba(22,54,92,.12)}
.fc-face.back{transform:rotateY(180deg); background:var(--green-soft); border-color:var(--green)}
.fc-face .lbl{font-family:var(--font-head); text-transform:uppercase; letter-spacing:.08em; font-size:.85rem; color:var(--muted)}
.fc-face .big{font-size:1.35rem; font-weight:700; color:var(--navy)}
.fc-face.back .big{color:var(--green)}
.fc-face .hint{font-size:.85rem; color:var(--muted); margin-top:auto}
.fc-nav{display:flex; justify-content:space-between; gap:8px; flex-wrap:wrap; max-width:720px; margin:0 auto}

/* ---------- quiz ---------- */
.q-card{max-width:780px; margin:0 auto}
.q-meta{display:flex; justify-content:space-between; gap:8px; flex-wrap:wrap; font-size:.9rem; color:var(--muted); margin-bottom:8px}
.q-text{font-size:1.25rem; font-weight:700; color:var(--navy); margin-bottom:14px}
.opts{display:flex; flex-direction:column; gap:8px}
.opt{display:flex; gap:10px; align-items:flex-start; text-align:left; border:2px solid var(--line); background:#fff; border-radius:10px; padding:10px 14px; color:var(--ink); font-size:1rem}
.opt .lt{flex:none; width:28px; height:28px; border-radius:50%; background:var(--blue-soft); color:var(--blue); display:grid; place-items:center; font-weight:700}
@media (hover:hover){.opt:hover:not(:disabled){border-color:var(--blue)}}
.opt.sel{border-color:var(--blue); background:var(--blue-soft)}
.opt.sel .lt{background:var(--blue); color:#fff}
.opt.right{border-color:var(--green); background:var(--green-soft)}
.opt.right .lt{background:var(--green); color:#fff}
.opt.wrong{border-color:var(--red); background:var(--red-soft)}
.opt.wrong .lt{background:var(--red); color:#fff}
.opt:disabled{cursor:default}
.fb{margin-top:12px; padding:10px 14px; border-radius:10px; font-size:.98rem}
.fb.ok{background:var(--green-soft); border-left:6px solid var(--green)}
.fb.ko{background:var(--red-soft); border-left:6px solid var(--red)}
.dots{display:flex; flex-wrap:wrap; gap:6px; margin:12px 0}
.dots button{width:34px; height:34px; border-radius:8px; border:2px solid var(--line); background:#fff; font-weight:700; font-size:.85rem; color:var(--ink)}
.dots button.ans{background:var(--blue-soft); border-color:var(--blue)}
.dots button.cur{border-color:var(--orange); box-shadow:0 0 0 2px var(--orange)}
.score-big{font-family:var(--font-head); font-size:4rem; font-weight:700; line-height:1; color:var(--navy)}
.score-wrap{display:flex; gap:24px; align-items:center; flex-wrap:wrap}
.review-item{border:1px solid var(--line); border-radius:10px; padding:10px 14px; margin-bottom:8px; background:#fff}
.review-item.ok{border-left:6px solid var(--green)}
.review-item.ko{border-left:6px solid var(--red)}
.stats{display:flex; gap:14px; flex-wrap:wrap; font-weight:700}
.stats span{background:#fff; border:1px solid var(--line); border-radius:8px; padding:6px 12px}

/* ---------- notes (apuntes) ---------- */
.print-controls{margin-bottom:18px}
.print-controls fieldset{border:0; padding:0; margin:0; display:flex; gap:14px; flex-wrap:wrap}
.print-controls legend{font-weight:700; color:var(--navy); margin-bottom:4px}
.print-controls label{display:flex; gap:6px; align-items:center}
.notes{background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:28px 34px}
.notes .cover{text-align:center; border-bottom:4px solid var(--navy); padding-bottom:18px; margin-bottom:18px}
.notes .cover h1{font-size:2.3rem; margin-bottom:.2em}
.notes .cover .sub{font-size:1.05rem; color:var(--muted)}
.notes .student{display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-top:14px; font-weight:700}
.notes .student span{border-bottom:1.5px solid var(--ink); min-width:220px; display:inline-block; text-align:left}
.notes .toc ol{columns:2; column-gap:30px}
.notes section.nsec{margin-top:26px}
.notes section.nsec > h2{border-bottom:3px solid var(--orange); padding-bottom:4px}
.notes section.nsec > h2 .n{color:var(--orange)}
.bank-q{margin-bottom:8px; break-inside:avoid}
.bank-q b{color:var(--navy)}
.notes.show-sol .sol-print{display:block}

/* B/N (black & white) mode — screen preview + print */
.notes.bw, .notes.bw *{
  --navy:#000; --blue:#000; --blue-soft:#fff; --orange:#000; --orange-soft:#fff;
  --green:#000; --green-soft:#fff; --red:#000; --red-soft:#fff; --yellow:#000; --yellow-soft:#fff;
  --purple:#000; --purple-soft:#fff; --ink:#000; --muted:#333; --line:#777;
}
.notes.bw .doc th{background:#fff; color:#000; border-bottom:2px solid #000}
.notes.bw .doc tr:nth-child(even) td{background:#fff}
.notes.bw .activity{background:#fff}
.notes.bw .circuit-static li, .notes.bw .tag{background:#fff; border:1px solid #000; color:#000}
.notes.bw .steps li::before{background:#fff; color:#000; border:2px solid #000}
.notes.bw .key b:first-child, .notes.bw .fx b, .notes.bw .box h4{color:#000}

.footer{font-size:.85rem; color:var(--muted); text-align:center; padding:20px 0}

@media (max-width:760px){
  body{font-size:16px}
  header.top{position:static}
  .brand b{font-size:1.1rem}
  .hero{grid-template-columns:1fr}
  .hero h1{font-size:2rem}
  .twocol,.grid2,.grid3{grid-template-columns:1fr}
  .notes{padding:18px 16px}
  .notes .toc ol{columns:1}
  .score-big{font-size:3rem}
}

@media print{
  @page{size:A4; margin:14mm 13mm}
  body{background:#fff!important; font-size:11pt; line-height:1.45}
  header.top, .no-print, .footer{display:none!important}
  main{padding:0}
  .wrap{max-width:none; padding:0}
  .card, .notes{border:0!important; box-shadow:none!important; padding:0!important}
  .notes:not(.bw){-webkit-print-color-adjust:exact; print-color-adjust:exact}
  .notes .cover{break-after:page}
  h2,h3,h4{break-after:avoid}
  .activity,.key,.note,.box,.fig,.formula,.mantra,.quote,tr,.review-item{break-inside:avoid}
  .tbl-scroll{overflow:visible}
  a{color:inherit; text-decoration:none}
  .review-item, .result-print *{-webkit-print-color-adjust:exact; print-color-adjust:exact}
}
</style>
</head>
<body>

<header class="top">
  <div class="wrap">
    <div class="top-row">
      <div class="brand">
        <small data-i18n="subject">Tecnología y Digitalización · 1.º ESO</small>
        <b data-i18n="unitTitle">U1 · El Proceso Tecnológico, el Taller y los Proyectos</b>
      </div>
      <div class="lang" role="group" aria-label="Idioma / Language">
        <button type="button" data-lang="es" aria-pressed="true">ES</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
    </div>
    <nav class="tabs" aria-label="Secciones">
      <a href="#inicio" data-view="inicio" data-i18n="navHome">Inicio</a>
      <a href="#contenidos" data-view="contenidos" data-i18n="navContents">Contenidos</a>
      <a href="#flashcards" data-view="flashcards" data-i18n="navFlash">Flashcards</a>
      <a href="#practica" data-view="practica" data-i18n="navPractice">Práctica</a>
      <a href="#examen" data-view="examen" data-i18n="navExam">Examen</a>
      <a href="#apuntes" data-view="apuntes" data-i18n="navNotes">Apuntes (PDF)</a>
    </nav>
  </div>
</header>

<main class="wrap">
  <section class="view" id="view-inicio"></section>
  <section class="view" id="view-contenidos"></section>
  <section class="view" id="view-flashcards"></section>
  <section class="view" id="view-practica"></section>
  <section class="view" id="view-examen"></section>
  <section class="view" id="view-apuntes"></section>
</main>

<div class="footer wrap" data-i18n="footer">Material de estudio basado exclusivamente en las presentaciones de la Unidad 1.</div>

<script>
"use strict";
/* =========================================================
   1. UI STRINGS
   ========================================================= */
const UI = {
  es:{
    subject:"Tecnología y Digitalización · 1.º ESO",
    unitTitle:"U1 · El Proceso Tecnológico, el Taller y los Proyectos",
    navHome:"Inicio", navContents:"Contenidos", navFlash:"Flashcards", navPractice:"Práctica", navExam:"Examen", navNotes:"Apuntes (PDF)",
    footer:"Material de estudio basado exclusivamente en las presentaciones de la Unidad 1.",
    heroKicker:"Unidad 1", heroTitle:"Del problema a la solución: bienvenidos al taller",
    heroText:"Aquí tienes todo lo que necesitas para estudiar la unidad: los contenidos explicados, tarjetas de memoria, preguntas de práctica con corrección inmediata, un examen con nota y unos apuntes listos para imprimir.",
    heroLang:"Puedes cambiar entre español e inglés en cualquier momento con el botón ES / EN.",
    mContents:"Contenidos", mContentsD:"Toda la teoría de la unidad, organizada en apartados desplegables.",
    mFlash:"Flashcards", mFlashD:"Tarjetas de pregunta y respuesta para memorizar. Pulsa para darles la vuelta.",
    mPractice:"Práctica", mPracticeD:"Preguntas por temas con corrección y explicación al momento.",
    mExam:"Examen", mExamD:"Ponte a prueba: preguntas al azar y nota final sobre 10.",
    mNotes:"Apuntes (PDF)", mNotesD:"Apuntes desarrollados para imprimir o guardar en PDF, en color o en blanco y negro.",
    go:"Entrar",
    expandAll:"Desplegar todo", collapseAll:"Plegar todo",
    contentsIntro:"Pulsa sobre cada apartado para desplegarlo. Las actividades tienen la solución escondida: intenta resolverlas antes de mirarla.",
    showSol:"Ver solución", solution:"Solución",
    topic:"Tema", allTopics:"Todos los temas",
