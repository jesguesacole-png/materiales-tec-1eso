/* =========================================================
   3. FIGURES (SVG, language-aware, colour via CSS variables)
   ========================================================= */
function processSVG(L){
  const labels = L==="es"
    ? [["Identificar","el problema"],["Buscar","información"],["Generar","ideas"],["Elegir la","mejor solución"],["Planificar y","organizar"],["Construir el","prototipo"],["Evaluar y","comprobar"],["Presentar y","comercializar"]]
    : [["Identify","the problem"],["Research","information"],["Generate","ideas"],["Choose the","best solution"],["Plan and","organise"],["Build the","prototype"],["Test and","evaluate"],["Present and","market"]];
  const center = L==="es" ? ["Si falla,","rediseña"] : ["If it fails,","redesign"];
  const cx=320, cy=232, R=184, r=44, n=8;
  let s = `<svg viewBox="0 0 640 464" role="img" aria-label="${L==="es"?"Ciclo del proceso tecnológico en 8 fases":"8-stage technological process cycle"}" xmlns="http://www.w3.org/2000/svg">`;
  s += `<defs><marker id="arw-${L}" viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="14" markerHeight="14" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" style="fill:var(--orange)"/></marker></defs>`;
  const ang = i => -Math.PI/2 + i*2*Math.PI/n;
  const d = (r+5)/R;
  for(let i=0;i<n;i++){
    const a1=ang(i)+d, a2=ang(i+1)-d;
    const x1=cx+R*Math.cos(a1), y1=cy+R*Math.sin(a1), x2=cx+R*Math.cos(a2), y2=cy+R*Math.sin(a2);
    s += `<path d="M${x1.toFixed(1)},${y1.toFixed(1)} A${R},${R} 0 0 1 ${x2.toFixed(1)},${y2.toFixed(1)}" style="fill:none;stroke:var(--orange);stroke-width:4" marker-end="url(#arw-${L})"/>`;
  }
  // redesign arrow: from node 7 (index 6) back toward node 3 (index 2), through centre
  const p7={x:cx+R*Math.cos(ang(6)), y:cy+R*Math.sin(ang(6))}, p3={x:cx+R*Math.cos(ang(2)), y:cy+R*Math.sin(ang(2))};
  s += `<path d="M${(p7.x+r+6).toFixed(1)},${(p7.y+14).toFixed(1)} Q${cx},${cy+70} ${(p3.x-r-8).toFixed(1)},${(p3.y+14).toFixed(1)}" style="fill:none;stroke:var(--red);stroke-width:3;stroke-dasharray:8 6" marker-end="url(#arw-${L})"/>`;
  s += `<text x="${cx}" y="${cy-8}" text-anchor="middle" style="font:700 22px var(--font-head);fill:var(--red)">${center[0]}</text>`;
  s += `<text x="${cx}" y="${cy+18}" text-anchor="middle" style="font:700 22px var(--font-head);fill:var(--red)">${center[1]}</text>`;
  for(let i=0;i<n;i++){
    const x=cx+R*Math.cos(ang(i)), y=cy+R*Math.sin(ang(i));
    s += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r}" style="fill:var(--card,#fff);stroke:var(--navy);stroke-width:3"/>`;
    s += `<text x="${x.toFixed(1)}" y="${(y-15).toFixed(1)}" text-anchor="middle" style="font:700 17px var(--font-head);fill:var(--orange)">${i+1}</text>`;
    s += `<text x="${x.toFixed(1)}" y="${(y+3).toFixed(1)}" text-anchor="middle" style="font:700 11.5px var(--font-body);fill:var(--navy)">${labels[i][0]}</text>`;
    s += `<text x="${x.toFixed(1)}" y="${(y+18).toFixed(1)}" text-anchor="middle" style="font:700 11.5px var(--font-body);fill:var(--navy)">${labels[i][1]}</text>`;
  }
  return s + `</svg>`;
}
function linesSVG(L){
  const t = L==="es"
    ? [["Continua gruesa","contornos visibles"],["Continua fina","líneas auxiliares / de cota"],["Discontinua","aristas ocultas que no vemos desde ese ángulo"]]
    : [["Thick continuous","visible outlines"],["Thin continuous","auxiliary / dimension lines"],["Dashed","hidden edges we cannot see from that angle"]];
  return `<svg viewBox="0 0 620 150" role="img" aria-label="${L==="es"?"Tipos de línea":"Line types"}" xmlns="http://www.w3.org/2000/svg">
    <line x1="10" y1="25" x2="190" y2="25" style="stroke:var(--ink);stroke-width:5"/>
