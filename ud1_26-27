      ex.list = pickExam(ex.n);
      ex.orders={}; ex.list.forEach(id=>ex.orders[id]=shuffle([0,1,2,3].slice(0,QUESTIONS[id].o.length)));
      ex.answers={}; ex.i=0; ex.phase="run"; ex.date=new Date();
