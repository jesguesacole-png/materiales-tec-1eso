      <div class="row">
        <button class="btn red" type="button" id="fcRev">↻ ${T("review")}</button>
        <button class="btn green" type="button" id="fcKnow">✔ ${T("know")}</button>
      </div>
      <button class="btn ghost" type="button" id="fcNext"${fc.i>=total-1?" disabled":""}>${T("next")} ▶</button>
    </div>`;
  }
  v.innerHTML = `
    <h2>${T("navFlash")}</h2>
    <div class="card no-print">
      <div class="row">
        <label class="field">${T("topic")}<select id="fcTopic">${topicOptions(fc.topic)}</select></label>
        <label style="display:flex;gap:6px;align-items:center;margin-top:18px"><input type="checkbox" id="fcOnly"${fc.onlyReview?" checked":""}> ${T("onlyReview")}</label>
        <button class="btn ghost" type="button" id="fcShuffle" style="margin-top:18px">🔀 ${T("shuffle")}</button>
        <button class="btn ghost" type="button" id="fcReset" style="margin-top:18px">${T("resetFc")}</button>
      </div>
      <div style="margin-top:12px" class="row muted">
        <span><b>${T("card")} ${total?fc.i+1:0} ${T("of")} ${total}</b></span>
        <span>✔ ${T("known")}: ${known}</span><span>↻ ${T("toReview")}: ${rev}</span>
      </div>
      <div class="progress" style="margin-top:8px"><span style="width:${total?((fc.i+1)/total*100):0}%"></span></div>
    </div>
    ${cardHTML}`;
  $("#fcTopic").onchange = e=>{ fc.topic=e.target.value; buildDeck(); renderFlash(); };
  $("#fcOnly").onchange = e=>{ fc.onlyReview=e.target.checked; buildDeck(); renderFlash(); };
  $("#fcShuffle").onclick = ()=>{ buildDeck(); fc.deck=shuffle(fc.deck); renderFlash(); };
  $("#fcReset").onclick = ()=>{ fc.marks={}; store.set("fcmarks",fc.marks); buildDeck(); renderFlash(); };
  if(total){
    const card=$("#fcCard");
