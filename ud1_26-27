      </div>
    </div>`;
    $$(".opt",v).forEach(b=>b.onclick=()=>{ ex.answers[id]=+b.dataset.oi; renderExam(); });
    $$("[data-go]",v).forEach(b=>b.onclick=()=>{ ex.i=+b.dataset.go; renderExam(); });
    $("#exPrev").onclick=()=>{ if(ex.i>0){ex.i--; renderExam();} };
    $("#exNext").onclick=()=>{ if(ex.i<ex.list.length-1){ex.i++; renderExam();} };
    $("#exFinish").onclick=()=>{
      const missing = ex.list.length - Object.keys(ex.answers).length;
      if(missing>0 && !window.confirm(T("confirmFinish").replace("{n}",missing))) return;
      ex.phase="done"; renderExam(); window.scrollTo({top:0});
    };
    return;
  }
  // results
  const total=ex.list.length;
  const hits = ex.list.filter(id=>ex.answers[id]===0).length;
  const grade = Math.round(hits/total*100)/10; // one decimal, 0–10
  const msg = T("gradeMsg").find(([min])=>grade>=min)[1];
  const byT = {}; ex.list.forEach(id=>{ const t=QUESTIONS[id].t; byT[t]=byT[t]||{h:0,n:0}; byT[t].n++; if(ex.answers[id]===0) byT[t].h++; });
  const dateStr = ex.date ? ex.date.toLocaleDateString(LANG==="es"?"es-ES":"en-GB",{day:"2-digit",month:"2-digit",year:"numeric"})+" "+ex.date.toLocaleTimeString(LANG==="es"?"es-ES":"en-GB",{hour:"2-digit",minute:"2-digit"}) : "";
  v.innerHTML = `<h2 class="no-print">${T("navExam")}</h2>
  <div class="card result-print">
    <p class="muted" style="margin:0 0 6px">${T("examOf")} · ${esc(T("unitTitle"))}<br>${ex.name?`<b id="exNameOut"></b> · `:""}${T("date")}: ${dateStr}</p>
    <div class="score-wrap">
      <div><div class="muted">${T("yourGrade")}</div><div class="score-big">${grade.toLocaleString(LANG==="es"?"es-ES":"en-GB",{minimumFractionDigits:1,maximumFractionDigits:1})}</div><div class="muted">${T("outOf")}</div></div>
      <div style="flex:1;min-width:220px"><p style="font-size:1.15rem;font-weight:700;color:var(--navy)">${msg}</p>
        <div class="stats"><span>✔ ${hits}</span><span>✘ ${total-hits}</span><span>${Math.round(hits/total*100)} %</span></div></div>
    </div>
    <h3 style="margin-top:18px">${T("byTopic")}</h3>
    <div class="doc tbl-scroll"><table><tr><th>${T("topic")}</th><th style="width:120px">${T("hits")}</th></tr>
      ${TOPICS.filter(t=>byT[t.id]).map(t=>`<tr><td>${esc(t[LANG])}</td><td>${byT[t.id].h} / ${byT[t.id].n}</td></tr>`).join("")}</table></div>
    <div class="row no-print" style="margin:8px 0 6px">
      <button class="btn orange" type="button" id="exAgain">${T("repeatExam")}</button>
      <button class="btn ghost" type="button" id="exPrint">🖨️ ${T("printResult")}</button>
    </div>
    <h3 style="margin-top:18px">${T("reviewTitle")}</h3>
    ${ex.list.map((id,k)=>{ const q=QUESTIONS[id], a=ex.answers[id], ok=a===0;
      return `<div class="review-item ${ok?"ok":"ko"}"><b>${k+1}. ${esc(q.q[LANG])}</b><br>
        ${T("yourAnswer")} ${a===undefined?`<i>${T("noAnswer")}</i>`:esc(q.o[a][LANG])} ${ok?"✔":"✘"}
        ${ok?"":`<br>${T("rightAnswer")} <b>${esc(q.o[0][LANG])}</b>`}
        <br><span class="muted">${esc(q.x[LANG])}</span></div>`;}).join("")}
  </div>`;
  const no=$("#exNameOut"); if(no) no.textContent = ex.name;
  $("#exAgain").onclick=()=>{ ex.phase="setup"; renderExam(); };
  $("#exPrint").onclick=()=>window.print();
}

// ---------- NOTES (printable) ----------
const nt = { bw: store.get("bw",false), sol: store.get("incSol",true), bank: store.get("incBank",false) };
function renderNotes(){
  const v=$("#view-apuntes");
  const secs = SECTIONS.map((s,i)=>`
    <section class="nsec doc"><h2><span class="n">${i+1}.</span> ${s[LANG].title}</h2>${s[LANG].html()}</section>`).join("");
  const bank = !nt.bank ? "" : `<section class="nsec doc"><h2>${T("bankTitle")}</h2>
    ${TOPICS.map((t,ti)=>{ const qs=QUESTIONS.filter(q=>q.t===t.id); return `<h3>${ti+1}. ${esc(t[LANG])}</h3>`+
      qs.map((q,k)=>`<div class="bank-q"><b>${k+1}. ${esc(q.q[LANG])}</b><br>✔ ${esc(q.o[0][LANG])}</div>`).join(""); }).join("")}</section>`;
  v.innerHTML = `
  <h2 class="no-print">${T("navNotes")}</h2>
  <div class="card print-controls no-print">
    <p style="margin-top:0">${T("notesIntro")}</p>
    <div class="row" style="gap:28px;align-items:flex-start">
      <fieldset><legend>${T("printMode")}</legend>
        <label><input type="radio" name="pm" value="color"${!nt.bw?" checked":""}> ${T("color")}</label>
        <label><input type="radio" name="pm" value="bw"${nt.bw?" checked":""}> ${T("bw")}</label></fieldset>
      <fieldset><legend>${T("include")}</legend>
        <label><input type="checkbox" id="ntSol"${nt.sol?" checked":""}> ${T("incSol")}</label>
        <label><input type="checkbox" id="ntBank"${nt.bank?" checked":""}> ${T("incBank")}</label></fieldset>
    </div>
    <div class="row" style="margin-top:14px"><button class="btn orange" type="button" id="ntPrint">🖨️ ${T("printBtn")}</button></div>
    <p class="muted" style="margin:10px 0 0;font-size:.9rem">${T("printTip")}</p>
  </div>
  <article class="notes${nt.bw?" bw":""}${nt.sol?" show-sol":""}" id="notesDoc">
    <div class="cover">
      <span class="tag orange">${T("heroKicker")}</span>
      <h1>${T("unitTitle").replace(/^U1 · /,"")}</h1>
      <div class="sub">${T("coverSub")}</div>
      <div class="student"><div>${T("name")} <span>&nbsp;</span></div><div>${T("group")} <span style="min-width:90px">&nbsp;</span></div></div>
      <div class="toc doc" style="text-align:left;margin-top:22px"><h3>${T("toc")}</h3>
        <ol>${SECTIONS.map(s=>`<li>${s[LANG].title}</li>`).join("")}${nt.bank?`<li>${T("bankTitle")}</li>`:""}</ol></div>
    </div>
    ${secs}
    ${bank}
  </article>`;
  // static versions of interactive bits
  const doc=$("#notesDoc");
  $$('[data-widget="circuit"]',doc).forEach(h=>{
    h.innerHTML = `<ul class="circuit-static">${CIRCUIT.shown.map(c=>`<li><span class="blank"></span>${esc(c[LANG])}</li>`).join("")}</ul>`;
  });
  $$("details.sol",doc).forEach(d=>{
    const div=document.createElement("div"); div.className="sol-print";
    const sm=d.querySelector("summary"); if(sm) sm.remove();
    div.innerHTML = `<b class="sl">${T("solution")}:</b>` + d.innerHTML;
    d.replaceWith(div);
  });
  $$('input[name="pm"]',v).forEach(r=>r.onchange=()=>{ if(!r.checked) return; nt.bw = (r.value==="bw"); store.set("bw",nt.bw); doc.classList.toggle("bw",nt.bw); });
  $("#ntSol").onchange=e=>{ nt.sol=e.target.checked; store.set("incSol",nt.sol); doc.classList.toggle("show-sol",nt.sol); };
  $("#ntBank").onchange=e=>{ nt.bank=e.target.checked; store.set("incBank",nt.bank); renderNotes(); };
  $("#ntPrint").onclick=()=>window.print();
}

/* =========================================================
   8. ROUTER + LANGUAGE
   ========================================================= */
const VIEWS = {inicio:renderHome, contenidos:renderContents, flashcards:renderFlash, practica:renderPractice, examen:renderExam, apuntes:renderNotes};
let currentView = "inicio";
function applyStaticI18n(){
  document.documentElement.lang = LANG;
  $$("[data-i18n]").forEach(el=>{ el.textContent = T(el.dataset.i18n); });
  $$(".lang button").forEach(b=>b.setAttribute("aria-pressed", String(b.dataset.lang===LANG)));
  document.title = T("unitTitle");
}
function route(){
  const h = (location.hash||"#inicio").slice(1).split("?")[0];
  currentView = VIEWS[h] ? h : "inicio";
  $$(".view").forEach(v=>v.classList.toggle("active", v.id==="view-"+currentView));
  $$("nav.tabs a").forEach(a=>{ if(a.dataset.view===currentView) a.setAttribute("aria-current","page"); else a.removeAttribute("aria-current"); });
  VIEWS[currentView]();
}
function setLang(l){
  if(l!=="es" && l!=="en") return;
  LANG=l; store.set("lang",l);
  try{ const u=new URL(location.href); if(u.searchParams.has("lang")){ u.searchParams.set("lang",l); history.replaceState(null,"",u.toString()); } }catch(e){}
  applyStaticI18n(); VIEWS[currentView]();
}
$$(".lang button").forEach(b=>b.addEventListener("click",()=>setLang(b.dataset.lang)));
window.addEventListener("hashchange", ()=>{ route(); window.scrollTo({top:0}); });
applyStaticI18n();
route();
</script>
</body>
