const ex = { phase:"setup", n:20, name:"", list:[], orders:{}, answers:{}, i:0, date:null };
function pickExam(n){
  // round-robin over topics so every topic is represented
  const pools = TOPICS.map(t=>shuffle(QUESTIONS.filter(q=>q.t===t.id).map(q=>q.id))).filter(p=>p.length);
  const out=[]; let k=0;
  const order = shuffle(pools.map((_,i)=>i));
  while(out.length<n && pools.some(p=>p.length)){
    const p = pools[order[k%order.length]]; if(p.length) out.push(p.shift()); k++;
  }
  return shuffle(out);
}
function renderExam(){
  const v=$("#view-examen");
  if(ex.phase==="setup"){
    v.innerHTML = `<h2>${T("navExam")}</h2>
