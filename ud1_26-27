// Broken-circuit interactive ordering
let circuitOrder = null;
function mountCircuit(host){
  if(!circuitOrder) circuitOrder = CIRCUIT.shown.map((_,i)=>i); // start in slide order (already mixed)
  const draw = (check=false)=>{
    host.innerHTML = `<ol class="circuit">${circuitOrder.map((ci,idx)=>{
      const c = CIRCUIT.shown[ci];
      const cls = check ? (c.pos===idx+1?"ok":"bad") : "";
      return `<li class="${cls}"><span class="pos">${idx+1}</span><span class="txt">${esc(c[LANG])}</span>
        <button type="button" data-mv="up" data-i="${idx}" aria-label="${LANG==="es"?"Subir":"Move up"}"${idx===0?" disabled":""}>▲</button>
        <button type="button" data-mv="down" data-i="${idx}" aria-label="${LANG==="es"?"Bajar":"Move down"}"${idx===circuitOrder.length-1?" disabled":""}>▼</button></li>`;}).join("")}</ol>
      <div class="row"><button type="button" class="btn green" data-act="check">${LANG==="es"?"Comprobar orden":"Check order"}</button>
      <button type="button" class="btn ghost" data-act="mix">${T("shuffle")}</button>
      <span class="muted" data-res></span></div>`;
    if(check){
      const ok = circuitOrder.filter((ci,idx)=>CIRCUIT.shown[ci].pos===idx+1).length;
      $("[data-res]",host).textContent = (LANG==="es"?`Bien colocadas: ${ok} de 8`:`Correctly placed: ${ok} of 8`) + (ok===8?" 🎉":"");
    }
  };
  host.onclick = e=>{
    const b = e.target.closest("button"); if(!b) return;
    if(b.dataset.mv){
      const i=+b.dataset.i, j = b.dataset.mv==="up"? i-1 : i+1;
      if(j<0||j>=circuitOrder.length) return;
      [circuitOrder[i],circuitOrder[j]]=[circuitOrder[j],circuitOrder[i]];
      draw(); const btn = host.querySelector(`button[data-mv="${b.dataset.mv}"][data-i="${j}"]`); if(btn && !btn.disabled) btn.focus();
    } else if(b.dataset.act==="check"){ draw(true); }
    else if(b.dataset.act==="mix"){ circuitOrder = shuffle(circuitOrder); draw(); }
  };
  draw();
}

